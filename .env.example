# ── Required for Docker ──────────────────────
# Copy this to .env and fill in your keys

# API Providers (required for reports)
DEEPSEEK_API_KEY=sk-...
SERPAPI_KEY=...
FIRECRAWL_API_KEY=...

# Clerk Auth
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_BOUSSOLE=price_...
STRIPE_PRICE_RADAR=price_...
STRIPE_PRICE_STRATEGE=price_...

# Optional: Apify (Meta Ads)
APIFY_TOKEN=apify_api_...

# Optional: PostgreSQL (instead of SQLite)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/brandcompass

# Optional: Redis (for ARQ task queue)
# REDIS_URL=redis://redis:6379
